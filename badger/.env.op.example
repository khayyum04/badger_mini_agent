# Copy to badger/.env.op (gitignored) and replace <your-item>.
#
# These are 1Password secret REFERENCES, not secrets. `op run` resolves them at launch and injects the
# real values into the launched process only — they never touch disk and never enter the task container.
#
#   op run --env-file=badger/.env.op -- ./badger/scripts/run_sample.sh fix-git
#
# In 1Password: open the item → field menu → "Copy Secret Reference". Quote refs containing spaces.
LLM_BASE_URL="op://Employee/<your-item>/base url"
LLM_API_KEY="op://Employee/<your-item>/credential"

# Model id exactly as GET $LLM_BASE_URL/models reports it (check with ./badger/scripts/check_endpoint.sh).
# Approved anchor for submissions: Qwen/Qwen3.6-27B-FP8. qwen3.8-27b is NOT on the approved list.
LLM_MODEL=Qwen3.6-27B-FP8
